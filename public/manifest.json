{
  "manifest_version": 3,
  "name": "Judol Detector",
  "version": "1.0.0",
  "description": "Pembasmian judol >:)",
  "permissions": ["storage", "tabs", "activeTab"],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ]
}